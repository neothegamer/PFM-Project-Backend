# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/pfm-dashboard

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Plaid (sandbox)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Token Encryption Key
TOKEN_ENCRYPTION_KEY=<that value>